# 무료 발급 키. 없으면 해당 소스만 비활성화되고 나머지는 정상 동작한다.

# SEC EDGAR: 키 불필요. 단 User-Agent에 연락처를 요구한다 (필수).
SEC_USER_AGENT="stock-analysis songal4546@gmail.com"

# FRED (미국 매크로·금리) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 한국은행 ECOS (기준금리·환율) — https://ecos.bok.or.kr/api/
ECOS_API_KEY=

# 금융감독원 OpenDART (한국 공시) — https://opendart.fss.or.kr/
OPENDART_API_KEY=

# 토스증권 Open API (2차) — 시세·종목정보·환율. 무료.
#   발급: 토스증권 WTS > 설정 > Open API
#   ★ 같은 화면 하단 "허용 IP 관리"에 이 머신의 공인 IP를 등록해야 한다.
#      미등록 IP는 403. 자격증명이 유출돼도 타 IP에서 못 쓰게 하는 보호 장치다.
#      공인 IP 확인:  curl -s ifconfig.me
#   이 자격증명은 주문 권한도 갖지만, src/sources/toss.py 가 계좌 헤더를 생성하지 않아
#   주문 경로가 코드에 존재하지 않는다. tests/test_layering.py 가 이를 검사한다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 유료 2차 벤더. 어닝콜 트랜스크립트·실적 캘린더용. 없으면 '확인 필요'로 표기된다.
FMP_API_KEY=
